<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_approval_pin" model="ir.ui.view">
        <field name="name">res.users.form.approval.pin</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page string="Approval PIN" name="approval_pin_page" invisible="share">
                    <group>
                        <group string="PIN Status">
                            <field name="approval_pin_is_set" readonly="1"/>
                        </group>
                        <group string="Actions">
                            <button name="action_open_set_approval_pin_wizard" type="object" string="Set / Change Approval PIN" class="btn btn-primary"/>
                            <button name="action_clear_approval_pin" type="object" string="Clear PIN" class="btn-link" invisible="not approval_pin_is_set" groups="base.group_system"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_simple_modif_approval_pin" model="ir.ui.view">
        <field name="name">res.users.form.simple.modif.approval.pin</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_security']" position="after">
                <page string="Approval PIN" name="approval_pin_security_page" invisible="share">
                    <group>
                        <group string="PIN Status">
                            <field name="approval_pin_is_set" readonly="1"/>
                        </group>
                        <group string="Actions">
                            <button name="action_open_set_approval_pin_wizard" type="object" string="Set / Change Approval PIN" class="btn btn-primary"/>
                            <button name="action_clear_approval_pin" type="object" string="Clear PIN" class="btn-link" invisible="not approval_pin_is_set" groups="base.group_system"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
