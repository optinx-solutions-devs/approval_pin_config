<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_approval_pin" model="ir.ui.view">
        <field name="name">account.move.form.approval.pin</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//button[@name='action_post'])[2]" position="attributes">
                <attribute name="name">action_request_approval_pin_post</attribute>
            </xpath>
            <xpath expr="//button[@name='action_register_payment' and @id='account_invoice_payment_btn']" position="attributes">
                <attribute name="name">action_register_payment</attribute>
            </xpath>
        </field>
    </record>
</odoo>
