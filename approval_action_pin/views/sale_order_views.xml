<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_approval_pin" model="ir.ui.view">
        <field name="name">sale.order.form.approval.pin</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm' and @id='action_confirm']" position="attributes">
                <attribute name="name">action_request_approval_pin_confirm</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm' and not(@id='action_confirm')]" position="attributes">
                <attribute name="name">action_request_approval_pin_confirm</attribute>
            </xpath>
        </field>
    </record>
</odoo>
