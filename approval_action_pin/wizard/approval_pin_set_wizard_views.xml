<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="approval_pin_set_wizard_view_form" model="ir.ui.view">
        <field name="name">approval.pin.set.wizard.form</field>
        <field name="model">approval.pin.set.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Approval PIN">
                <group>
                    <field name="user_id"/>
                    <field name="new_pin" password="True"/>
                    <field name="confirm_pin" password="True"/>
                </group>
                <footer>
                    <button name="action_set_pin" type="object" string="Save PIN" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
